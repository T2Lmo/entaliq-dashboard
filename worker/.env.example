# انسخ هذا الملف إلى .env في المجلد نفسه واملأ القيم. لا ترفع .env إلى GitHub.
EXEC_URL=https://script.google.com/macros/s/XXXX/exec
WORKER_TOKEN=ضع-هنا-نفس-قيمة-WORKER_TOKEN-في-Script-Properties
CLAUDE_MODEL=sonnet
# CLAUDE_BIN=claude

# ---- بريد الشركة: إرسال رسائل مازن التي توافق عليها (اختياري؛ بدونها تُرسل يدوياً من اللوحة) ----
# Hostinger: SMTP_HOST=smtp.hostinger.com و SMTP_PORT=465. كلمة المرور تبقى على جهازك فقط ولا تُرسل للخادم.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@entaliq.com.sa
# SMTP_PASS=كلمة-مرور-صندوق-البريد
# MAIL_FROM=info@entaliq.com.sa
# MAIL_FROM_NAME=انطلق للطاقة
# نسخة مخفية لكل رسالة إلى بريدك لتظهر عندك (اختياري):
# MAIL_BCC=info@entaliq.com.sa
# للتجربة: node claude-worker.mjs --mail-test   يرسل رسالة تجريبية إلى MAIL_FROM

# ---- قراءة الوارد: ردود رسائل مازن والارتدادات وطلبات الإيقاف (تلقائية مع بيانات SMTP أعلاه) ----
# تستخدم نفس البريد وكلمة المرور، وخادم imap.hostinger.com:993. لا يُرسل للخادم إلا ما يخص رسائل مازن.
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_USER=info@entaliq.com.sa
# IMAP_PASS=كلمة-مرور-صندوق-البريد
# لإيقاف قراءة الوارد: INBOX_READ=false
# للتجربة: node claude-worker.mjs --inbox-test
